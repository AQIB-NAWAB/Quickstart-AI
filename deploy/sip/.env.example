# Self-hosted SIP stack (livekit-server + livekit/sip + redis).
# Copy to deploy/sip/.env (or just run ./render-config.sh, which does it for you).
# Values are read literally by render-config.sh and docker compose: no quotes, no spaces.

# --- LiveKit credentials -----------------------------------------------------
# Leave empty: render-config.sh generates them and writes them back here.
# The secret must be >= 32 characters. voice-service uses the same pair.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Public identity of this host --------------------------------------------
# Public DNS name carriers/PBXes send SIP to (becomes LIVEKIT_SIP_ENDPOINT).
# Falls back to PUBLIC_IP when empty.
SIP_HOST=
# Public IPv4 of this host. Empty = livekit/sip and livekit-server discover it
# via STUN (use_external_ip: true). Set it explicitly when the host has a static
# 1:1 NAT (cloud VM with elastic IP) and STUN discovery returns the wrong address.
PUBLIC_IP=
# 1 = render-config.sh asks a public "what is my IP" service to suggest PUBLIC_IP
# (informational only; it is never pinned automatically). Same as --detect-ip.
DETECT_PUBLIC_IP=0

# --- SIP signalling + media (livekit/sip) ------------------------------------
SIP_PORT=5060
# Empty = TLS disabled. Usually 5061. Requires the cert/key below.
SIP_TLS_PORT=
# Host directory holding the certificate files; mounted read-only at /certs.
SIP_CERTS_DIR=./certs
# Paths INSIDE the container (i.e. under /certs).
SIP_TLS_CERT_FILE=/certs/fullchain.pem
SIP_TLS_KEY_FILE=/certs/privkey.pem
# UDP range for RTP audio. ~2 ports per concurrent call; 10000-20000 is ~5000 calls.
RTP_PORT_RANGE=10000-20000
# livekit/sip health endpoint (HTTP, listens on all interfaces: do NOT expose it).
SIP_HEALTH_PORT=8081
SIP_LOG_LEVEL=info

# --- livekit-server -----------------------------------------------------------
LIVEKIT_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
# UDP range for WebRTC media between livekit-server and the voice-service bridge.
# Must not overlap RTP_PORT_RANGE.
LIVEKIT_RTC_PORT_RANGE=50000-60000
LIVEKIT_LOG_LEVEL=info
# URL the voice-service uses to reach livekit-server. Empty = ws://127.0.0.1:7880
# (voice-service on the same host). Use wss://livekit.example.com when remote.
LIVEKIT_PUBLIC_URL=

# --- Webhook ------------------------------------------------------------------
# Public https URL of voice-service. livekit-server posts room/participant events to
# ${VOICE_PUBLIC_BASE_URL}/voice/telephony/livekit/webhook. Empty = no webhook block
# (calls will ring but the bridge will never start).
VOICE_PUBLIC_BASE_URL=

# --- Redis (loopback only) ----------------------------------------------------
REDIS_PORT=6379

# --- Image tags (pinned; bump deliberately, see README "Upgrade") --------------
LIVEKIT_SERVER_IMAGE=livekit/livekit-server:v1.13.11
LIVEKIT_SIP_IMAGE=livekit/sip:v1.23.0
REDIS_IMAGE=redis:7-alpine
